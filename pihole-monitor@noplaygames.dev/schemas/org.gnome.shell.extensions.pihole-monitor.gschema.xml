<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="pihole-monitor">
  <schema id="org.gnome.shell.extensions.pihole-monitor"
          path="/org/gnome/shell/extensions/pihole-monitor/">
    <key name="url" type="s">
      <default>''</default>
      <summary>Dirección de Pi-hole</summary>
      <description>Sin /admin, por ejemplo http://192.168.1.2:8080</description>
    </key>
    <key name="app-password" type="s">
      <default>''</default>
      <summary>Contraseña de aplicación</summary>
      <description>Se genera en Pi-hole: Settings → Web interface / API → Configure app password.</description>
    </key>
    <key name="replica-url" type="s">
      <default>''</default>
      <summary>Dirección del Pi-hole de respaldo</summary>
      <description>Opcional. Por ejemplo http://192.168.1.3:8080. Vacío si no hay respaldo.</description>
    </key>
    <key name="replica-app-password" type="s">
      <default>''</default>
      <summary>Contraseña de aplicación del respaldo</summary>
      <description>Opcional. Sin ella solo se comprueba si responde y no se puede pausar su bloqueo.</description>
    </key>
    <key name="refresh-seconds" type="i">
      <range min="5" max="600"/>
      <default>30</default>
      <summary>Intervalo de actualización en segundos</summary>
    </key>
    <key name="accept-invalid-certs" type="b">
      <default>true</default>
      <summary>Aceptar certificados autofirmados</summary>
      <description>Solo importa si la dirección usa https.</description>
    </key>
  </schema>
</schemalist>
